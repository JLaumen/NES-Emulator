cabal-version: 3.14
name: nes
version: 0.1.0.0
synopsis: A small, simple NES emulator
license: MIT
license-file: LICENSE
author: JLaumen
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files: README.md

common shared
  default-language: GHC2024
  ghc-options:
    -O2
    -Werror
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints
    -Wredundant-bang-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wunused-packages
    -Woperator-whitespace

  build-depends: base ^>=4.22

library
  import: shared
  hs-source-dirs: src
  exposed-modules: NES
  other-modules:
    APU
    Bus
    Cartridge
    Controller
    CPU
    Mapper
    PPU
    Visualise

  build-depends:
    array ^>=0.5.8,
    bytestring ^>=0.12.2,
    primitive ^>=0.9.1,
    vector ^>=0.13.2,

executable nes
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  -- SDL calls the audio callback from its own thread. A big allocation
  -- area means fewer garbage collections.
  ghc-options:
    -threaded
    -with-rtsopts=-A16m

  build-depends:
    bytestring,
    containers ^>=0.8,
    nes,
    sdl2 ^>=2.5.6,
    vector ^>=0.13.2,
